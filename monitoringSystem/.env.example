# Copy to monitoringSystem/.env for local development. .env is gitignored.
# On the VM these come from the repo-root .env through PM2 instead.

# Where the dashboard's server reaches the API.
API_URL=http://127.0.0.1:8000

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, `python app.py` uses a random key (everyone is signed out on
# every restart) and gunicorn refuses to start.
DASHBOARD_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
