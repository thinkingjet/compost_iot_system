# Copy to .env and fill in
# Matches the local database in compose.yaml (`docker compose up -d`).
DATABASE_URL=postgresql+psycopg2://compostiq:compostiq_dev@127.0.0.1:5432/compostiq

# Signs the users' sign-in tokens (JWT). Required, at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
# Optional: how long a sign-in lasts. Defaults to 8.
# JWT_EXPIRY_HOURS=8
# Optional: how long a device pairing code stays valid. Defaults to 10.
# PAIRING_CODE_MINUTES=10

# Optional: the compost stage model behind GET /bins/{id}/stage (README: Compost stage estimate).
# Absolute paths, or relative to backendAPI/. Unset = the defaults below.
# The code that runs it: ml/predict.py and ml/features.py.
# ML_DIR=../ml
# The model bundle ml/train.py writes (the fitted classifier, its features, stage names and filter).
# STAGE_MODEL_PATH=../ml/models/compost_stage_gb.joblib
# JSON replacing the bundle's features, stage_names and/or transitions. Start one with
#   uv run python stage_model.py --export-params stage_params.json
# STAGE_MODEL_PARAMS=stage_params.json
